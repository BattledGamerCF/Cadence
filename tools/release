#!/bin/sh
# Build the mod and package it, locally (nothing is uploaded anywhere):
# - dist/cadence-VERSION.jar, the single-jar install (tools/bundle.py): the Metal mod, natives inside, with the fps counter
#   and the shader-pack loader nested through Fabric's jar-in-jar. Put it in the mods folder; this build runs without Sodium.
# - dist/cadence-VERSION.zip: cadence-VERSION/{cadence-VERSION.jar, README.txt, LICENSE, NOTICE, CREDITS.md}, the same jar byte for
#   byte (README.txt is packaging/RELEASE-README.txt with the version filled in).
# Usage: tools/release
set -eu
cd "$(dirname "$0")/.."
die() { echo "$*" >&2; exit 1; }
version=$(sed -n "s/^version = '\(.*\)'$/\1/p" metal/build.gradle)
[ -n "$version" ] || die "No version in metal/build.gradle."
./gradlew :metal:build :fpshud:build :shaders:build -q --console=plain
jar=metal/build/libs/cadence-metal-$version.jar
[ -f "$jar" ] || die "The build made no $jar."
fps=fpshud/build/libs/cadence-hud-$version.jar
[ -f "$fps" ] || die "The build made no $fps."
shaders_version=$(sed -n "s/^version = '\(.*\)'$/\1/p" shaders/build.gradle)
shaders=shaders/build/libs/cadence-shaders-$shaders_version.jar
[ -f "$shaders" ] || die "The build made no $shaders."
name=cadence-$version
mkdir -p dist
python3 tools/bundle.py --metal "$jar" --fps "$fps" --shaders "$shaders" --out "dist/cadence-$version.jar"
rm -rf "dist/$name" "dist/$name.zip"
mkdir -p "dist/$name"
cp "dist/cadence-$version.jar" "dist/$name/cadence-$version.jar"
cp LICENSE NOTICE CREDITS.md "dist/$name/"
sed "s/@VERSION@/$version/g" packaging/RELEASE-README.txt > "dist/$name/README.txt"
(cd dist && zip -qrX "$name.zip" "$name")
echo "dist/$name.zip"
